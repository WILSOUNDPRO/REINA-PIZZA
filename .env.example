# ───── Base de données (Supabase → Project Settings → Database → Connection string) ─────
# Utilisée UNIQUEMENT côté serveur. Le pooler transactionnel (port 6543) est supporté.
DATABASE_URL=postgresql://postgres:CHANGEME@db.xxxxx.supabase.co:5432/postgres

# ───── Supabase Auth (connexion administrateur) et Storage (photos du menu) ─────
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY sont aussi acceptées.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
# Clé de service : SECRÈTE, serveur uniquement, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ───── Site ─────
# URL publique (sans / final) utilisée dans les liens copiés pour les clients.
SITE_URL=http://localhost:3000
# Sel pour hacher les adresses IP du limiteur de débit (chaîne aléatoire longue).
RATE_LIMIT_SALT=

# ───── Paiement en ligne : DÉSACTIVÉ dans cette version ─────
# Le paiement est organisé hors site avec la pizzeria. L'architecture est conservée mais inactive.
# ONLINE_PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=none          # none | simulation (développement uniquement, ignoré en production)
# SIMULATION_WEBHOOK_SECRET=

# ───── E-mail (non implémenté : laisser vide) ─────
# EMAIL_PROVIDER=
